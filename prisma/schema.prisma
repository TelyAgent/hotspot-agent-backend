generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PlatformCollectionConfig {
  id              String   @id
  platform        String   @unique
  connectorId     String
  displayName     String
  enabled         Boolean  @default(true)
  defaultTimezone String
  defaultRegions  Json
  rateLimit       Json?
  variables       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("platform_collection_config")
}

model CollectionJobConfig {
  id             String   @id
  platform       String
  name           String
  toolName       String
  sourceType     String
  enabled        Boolean  @default(true)
  schedule       Json
  inputTemplate  Json
  variableRefs   Json
  outputTarget   Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([platform])
  @@map("collection_job_config")
}

model OperationAccount {
  id          String   @id
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(true)
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("operation_account")
}

model AccountResponseTask {
  id                     String   @id
  eventId                String
  accountId              String
  workflowRunId          String?
  assignmentCommandId    String?
  status                 String
  priority               String
  skill                  String
  skillVersion           String
  assignmentReason       String
  riskStatus             String
  latestCandidateBatchId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([eventId, accountId])
  @@index([status, priority, createdAt])
  @@index([eventId])
  @@index([accountId])
  @@map("account_response_task")
}

model ContentCandidateBatch {
  id              String   @id
  taskId          String
  workflowRunId   String
  generationKind  String
  userInstruction String?
  status          String
  createdAt       DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("content_candidate_batch")
}

model ContentCandidate {
  id               String   @id
  batchId          String
  taskId           String
  localKey         String
  format           String
  text             String
  targetPostUrl    String?
  angle            String
  factualClaims    Json
  uncertaintyNotes Json
  productBridge    String?
  riskStatus       String
  precheckPayload  Json?
  status           String
  createdAt        DateTime @default(now())

  @@index([taskId, status])
  @@index([batchId])
  @@map("content_candidate")
}

model PublicationRecord {
  id             String    @id
  taskId         String
  candidateId    String
  eventId        String
  accountId      String
  url            String    @unique
  status         String
  publishedAt    DateTime
  trackingStatus String
  trackingEndsAt DateTime?
  wellPerforming Boolean   @default(false)
  trackingRuleVersion String @default("publication-tracking-v1")
  lastTrackingError String?
  lastTrackingErrorAt DateTime?
  trackingFailureCount Int @default(0)
  eventFormedAt DateTime?
  urlFilledAt DateTime?
  firstPublishLatencyMs Int?
  createdAt      DateTime  @default(now())

  @@index([eventId, accountId])
  @@index([taskId])
  @@map("publication_record")
}

model PublicationMetric {
  id                  String   @id
  publicationRecordId String
  capturedAt          DateTime
  likes               Int      @default(0)
  replies             Int      @default(0)
  reposts             Int      @default(0)
  quotes              Int?
  views               Int?
  raw                 Json?
  createdAt           DateTime @default(now())

  @@index([publicationRecordId, capturedAt])
  @@map("publication_metric")
}

model TopicCircleConfig {
  id               String   @id
  name             String   @unique
  description      String?
  enabled          Boolean  @default(true)
  keywords         Json
  positiveExamples Json
  negativeExamples Json
  workflowId       String
  ruleVersion      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accounts   TopicCircleAccount[]
  candidates TopicCircleCandidate[]

  @@map("topic_circle_config")
}

model TopicCircleAccount {
  id            String   @id
  topicCircleId String
  handle        String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topicCircle TopicCircleConfig @relation(fields: [topicCircleId], references: [id], onDelete: Cascade)

  @@unique([topicCircleId, handle])
  @@index([handle])
  @@map("topic_circle_account")
}

model TopicCircleFetchRun {
  id           String    @id
  platform     String
  status       String
  startedAt    DateTime
  finishedAt   DateTime?
  accountCount Int       @default(0)
  itemCount    Int       @default(0)
  error        String?
  input        Json

  accountRuns TopicCircleAccountFetchRun[]

  @@index([platform, status, startedAt])
  @@map("topic_circle_fetch_run")
}

model TopicCircleAccountSyncState {
  id                        String    @id
  platform                  String
  handle                    String
  lastSuccessfulCollectedAt DateTime?
  lastAttemptedAt           DateTime?
  lastError                 String?
  updatedAt                 DateTime  @updatedAt

  @@unique([platform, handle])
  @@map("topic_circle_account_sync_state")
}

model TopicCircleAccountFetchRun {
  id            String    @id
  fetchRunId    String
  topicCircleId String
  handle        String
  status        String
  startedAt     DateTime
  finishedAt    DateTime?
  since         DateTime
  until         DateTime
  itemCount     Int       @default(0)
  error         String?

  fetchRun TopicCircleFetchRun @relation(fields: [fetchRunId], references: [id], onDelete: Cascade)

  @@index([handle, startedAt])
  @@map("topic_circle_account_fetch_run")
}

model XTopicCirclePost {
  id             String   @id
  postId         String   @unique
  fetchRunId     String
  accountRunId   String
  topicCircleId  String
  authorHandle   String
  authorId       String?
  authorName     String?
  text           String
  url            String?
  postType       String
  replyToPostId  String?
  repostedPostId String?
  quotedPostId   String?
  publishedAt    DateTime
  observedAt     DateTime
  metrics        Json?
  raw            Json

  @@index([topicCircleId, publishedAt])
  @@index([authorHandle, publishedAt])
  @@map("x_topic_circle_post")
}

model TopicCircleCandidate {
  id                 String    @id
  topicCircleId      String
  title              String
  summary            String
  coreFact           String
  normalizedEventKey String
  confidence         Float
  status             String
  b3h                Int       @default(0)
  b24h               Int       @default(0)
  tmax               Float?
  tmaxPostId         String?
  tmaxTop5           Boolean   @default(false)
  triggeredAt        DateTime?
  triggerType        String?
  eventId            String?
  workflowRunId      String?
  ruleVersion        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  topicCircle TopicCircleConfig @relation(fields: [topicCircleId], references: [id], onDelete: Cascade)
  posts TopicCircleCandidatePost[]

  @@unique([topicCircleId, normalizedEventKey])
  @@index([topicCircleId, status, updatedAt])
  @@index([normalizedEventKey])
  @@map("topic_circle_candidate")
}

model TopicCircleCandidatePost {
  id                 String   @id
  candidateId        String
  platform           String
  postTable          String
  postId             String
  handle             String
  publishedAt        DateTime
  contributionWindow Json
  createdAt          DateTime @default(now())

  candidate TopicCircleCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, platform, postId])
  @@index([postId])
  @@map("topic_circle_candidate_post")
}

model SourceFetchRun {
  id          String    @id
  platform    String
  connectorId String
  toolName    String
  sourceType  String
  status      String
  input       Json
  startedAt   DateTime
  finishedAt  DateTime?
  itemCount   Int       @default(0)
  error       String?

  @@index([platform, sourceType, startedAt])
  @@map("source_fetch_run")
}

model XTrendSnapshot {
  id          String   @id
  fetchRunId  String
  region      String
  collectedAt DateTime
  itemCount   Int
  checksum    String?
  raw         Json?

  items XTrendSnapshotItem[]

  @@unique([region, collectedAt])
  @@index([fetchRunId])
  @@map("x_trend_snapshot")
}

model XTrendSnapshotItem {
  id               String  @id
  xTrendSnapshotId String
  rank             Int
  name             String
  query            String?
  url              String?
  volume           Int?
  category         String?
  normalizedKey    String
  raw              Json

  snapshot XTrendSnapshot @relation(fields: [xTrendSnapshotId], references: [id], onDelete: Cascade)

  @@unique([xTrendSnapshotId, normalizedKey])
  @@map("x_trend_snapshot_item")
}

model XPost {
  id              String   @id
  fetchRunId      String
  postId          String   @unique
  authorId        String?
  authorHandle    String
  authorName      String?
  text            String
  url             String?
  publishedAt     DateTime
  replyToPostId   String?
  repostedPostId  String?
  quotedPostId    String?
  observedAt      DateTime
  raw             Json

  @@index([authorHandle, publishedAt])
  @@map("x_post")
}

model XPostMetric {
  id         String   @id
  fetchRunId String
  postId     String
  observedAt DateTime
  views      Int?
  likes      Int?
  reposts    Int?
  replies    Int?
  quotes     Int?
  bookmarks  Int?
  raw        Json

  @@unique([postId, observedAt])
  @@map("x_post_metric")
}

model SourceSnapshot {
  id                 String   @id
  platform           String
  platformSnapshotId String
  sourceType         String
  region             String
  collectedAt        DateTime
  fetchRunId         String
  itemCount          Int

  items SourceSnapshotItem[]

  @@index([platform, sourceType, region, collectedAt])
  @@map("source_snapshot")
}

model SourceSnapshotItem {
  id               String @id
  sourceSnapshotId String
  platform         String
  platformItemId   String
  sourceType       String
  region           String
  rank             Int
  title            String
  normalizedKey    String
  metrics          Json?

  snapshot SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Cascade)

  @@unique([sourceSnapshotId, normalizedKey])
  @@map("source_snapshot_item")
}

model SourceSnapshotDiff {
  id                 String  @id
  platform           String
  region             String
  currentSnapshotId  String
  previousSnapshotId String?
  entered            Json
  exited             Json
  rankUp             Json
  rankDown           Json
  unchanged          Json
  createdAt          DateTime @default(now())

  @@index([platform, region, currentSnapshotId])
  @@map("source_snapshot_diff")
}

model Signal {
  id               String   @id
  platformRefTable String?
  platformRefId    String?
  snapshotId       String?
  fetchRunId       String
  platform         String
  sourceType       String
  sourceItemId     String
  title            String
  summary          String?
  text             String?
  url              String?
  region           String?
  rank             Int?
  authorHandle     String?
  publishedAt      DateTime?
  observedAt       DateTime
  metrics          Json?
  normalizedKey    String?
  raw              Json?

  @@unique([platform, sourceType, sourceItemId])
  @@index([platform, sourceType, region, observedAt])
  @@map("signal")
}

model WorkflowDefinition {
  id               String   @id
  workflowId       String
  name             String
  type             String
  version          String
  status           String
  markdownPath     String
  outputSchemaPath String
  checksum         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  runs WorkflowRun[]

  @@unique([workflowId, version])
  @@index([type, status])
  @@map("workflow_definition")
}

model WorkflowRun {
  id                   String    @id
  workflowDefinitionId String
  status               String
  startedAt            DateTime
  finishedAt           DateTime?
  model                String?
  input                Json
  output               Json?
  error                String?

  definition          WorkflowDefinition          @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  commands            WorkflowCommand[]
  commandExecutions   WorkflowCommandExecution[]
  eventIntakes        EventIntake[]
  eventSourceContexts EventSourceContext[]
  eventEvidence       EventEvidence[]
  ignoredSignals      IgnoredSignal[]

  @@index([workflowDefinitionId, startedAt])
  @@index([status, startedAt])
  @@map("workflow_run")
}

model WorkflowCommand {
  id             String   @id
  workflowRunId  String
  type           String
  idempotencyKey String   @unique
  payload        Json
  createdAt      DateTime @default(now())

  run        WorkflowRun                @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  executions WorkflowCommandExecution[]

  @@index([workflowRunId])
  @@map("workflow_command")
}

model WorkflowCommandExecution {
  id                String   @id
  workflowCommandId String
  workflowRunId     String
  commandType        String
  idempotencyKey     String
  status             String
  targetEventId      String?
  error              String?
  createdAt          DateTime @default(now())

  command WorkflowCommand @relation(fields: [workflowCommandId], references: [id], onDelete: Cascade)
  run     WorkflowRun     @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([idempotencyKey])
  @@map("workflow_command_execution")
}

model Event {
  id                 String   @id
  title              String
  normalizedEventKey String   @unique
  status             String
  confidence         String
  formedAt           DateTime
  updatedAt          DateTime @updatedAt

  intakes        EventIntake[]
  sourceContexts EventSourceContext[]
  evidence       EventEvidence[]
  futureLinks    FutureEventResponseLink[]

  @@index([status, formedAt])
  @@map("event")
}

model EventIntake {
  id                 String   @id
  eventId            String?
  workflowRunId      String
  entryMode          String
  observedAt         DateTime
  t0                 DateTime?
  title              String
  oneLineSummary     String
  confirmationLevel  String
  expressionBoundary String
  payload            Json
  dedupeKey          String
  createdAt          DateTime @default(now())

  event Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  run   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([dedupeKey])
  @@map("event_intake")
}

model EventSourceContext {
  id            String   @id
  eventId       String
  workflowRunId String
  sourceType    String
  payload       Json
  createdAt     DateTime @default(now())

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  run   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([eventId, sourceType])
  @@map("event_source_context")
}

model EventEvidence {
  id            String   @id
  eventId       String
  workflowRunId String
  sourceType    String
  url           String?
  claim         String
  payload       Json
  createdAt     DateTime @default(now())

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  run   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([eventId, sourceType])
  @@map("event_evidence")
}

model IgnoredSignal {
  id            String   @id
  workflowRunId String
  reason        String
  sourceRefs    Json
  createdAt     DateTime @default(now())

  run WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@map("ignored_signal")
}

model FutureSourceConfig {
  id          String   @id
  sourceType  String   @unique
  displayName String
  connectorId String
  enabled     Boolean  @default(true)
  schedule    Json
  variables   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs FutureSourceRun[]

  @@map("future_source_config")
}

model FutureSourceRun {
  id             String    @id
  sourceConfigId String?
  sourceType     String
  status         String
  startedAt      DateTime
  finishedAt     DateTime?
  itemCount      Int       @default(0)
  error          String?
  input          Json
  rawSummary     Json?

  sourceConfig FutureSourceConfig? @relation(fields: [sourceConfigId], references: [id], onDelete: SetNull)
  items        FutureSourceItem[]

  @@index([sourceType, startedAt])
  @@map("future_source_run")
}

model FutureSourceItem {
  id            String   @id
  sourceRunId   String
  sourceType    String
  sourceItemId  String
  sourceUrl     String
  retrievedAt   DateTime
  title         String
  description   String?
  startTime     DateTime?
  endTime       DateTime?
  timezone      String
  raw           Json
  createdAt     DateTime @default(now())

  sourceRun FutureSourceRun       @relation(fields: [sourceRunId], references: [id], onDelete: Cascade)
  evidence  FutureEventEvidence[]

  @@unique([sourceType, sourceItemId])
  @@index([sourceRunId])
  @@map("future_source_item")
}

model FutureEvent {
  id                 String    @id
  title              String
  subject            String
  eventType          String
  dedupeKey          String    @unique
  factTime           DateTime?
  factEndTime        DateTime?
  timezone           String
  schedulePrecision  String
  confirmationLevel  String
  expressionBoundary String
  status             String
  relatedEventId     String?
  entryMode          String?
  currentScore       Int       @default(0)
  currentScoreBand   String
  ruleVersion        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  evidence      FutureEventEvidence[]
  windows       FutureEventWindow[]
  heatQueries   FutureEventHeatQuery[]
  heatBuckets   FutureEventHeatBucket[]
  scoreVersions FutureEventScoreVersion[]
  responseCards FutureResponseCard[]
  responseLinks FutureEventResponseLink[]

  @@index([factTime])
  @@index([status, factTime])
  @@map("future_event")
}

model FutureEventEvidence {
  id             String   @id
  futureEventId  String
  sourceItemId   String?
  sourceType     String
  url            String
  verifiedAt     DateTime
  claims         Json
  raw            Json?
  createdAt      DateTime @default(now())

  futureEvent FutureEvent       @relation(fields: [futureEventId], references: [id], onDelete: Cascade)
  sourceItem  FutureSourceItem? @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  @@index([futureEventId])
  @@index([sourceType])
  @@map("future_event_evidence")
}

model FutureEventWindow {
  id            String    @id
  futureEventId String
  windowType    String
  startAt       DateTime?
  endAt         DateTime?
  source        String
  version       String
  createdAt     DateTime  @default(now())

  futureEvent FutureEvent @relation(fields: [futureEventId], references: [id], onDelete: Cascade)

  @@index([futureEventId, windowType])
  @@map("future_event_window")
}

model FutureEventHeatQuery {
  id            String   @id
  futureEventId String
  query         String
  version       String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  futureEvent FutureEvent @relation(fields: [futureEventId], references: [id], onDelete: Cascade)

  @@index([futureEventId, active])
  @@map("future_event_heat_query")
}

model FutureEventHeatBucket {
  id            String   @id
  futureEventId String
  queryVersion  String
  startAt       DateTime
  endAt         DateTime
  postCount     Int
  sourceType    String
  createdAt     DateTime @default(now())

  futureEvent FutureEvent @relation(fields: [futureEventId], references: [id], onDelete: Cascade)

  @@unique([futureEventId, queryVersion, startAt, endAt])
  @@index([futureEventId, startAt])
  @@map("future_event_heat_bucket")
}

model FutureEventScoreVersion {
  id               String   @id
  futureEventId    String
  total            Int
  impact           Json
  evidence         Int
  heatMomentum     Int
  timeUrgency      Int
  contentReadiness Int
  band             String
  reasons          Json
  workflowRunId    String?
  version          String
  createdAt        DateTime @default(now())

  futureEvent FutureEvent @relation(fields: [futureEventId], references: [id], onDelete: Cascade)

  @@index([futureEventId, createdAt])
  @@map("future_event_score_version")
}

model FutureResponseCard {
  id              String   @id
  futureEventId   String
  status          String
  scoreAtCreation Int
  reason          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  futureEvent FutureEvent @relation(fields: [futureEventId], references: [id], onDelete: Cascade)

  @@index([futureEventId, status])
  @@map("future_response_card")
}

model FutureEventResponseLink {
  id            String   @id
  futureEventId String
  eventId       String
  entryMode     String
  createdBy     String
  createdAt     DateTime @default(now())

  futureEvent FutureEvent @relation(fields: [futureEventId], references: [id], onDelete: Cascade)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([futureEventId, entryMode])
  @@index([eventId])
  @@map("future_event_response_link")
}
