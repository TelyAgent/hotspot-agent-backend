PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotspot_agent_v2
AUTO_CREATE_DATABASE=true
AUTO_PUSH_DATABASE_SCHEMA=true
TWITTERAPI_IO_KEY=
TWITTERAPI_BASE_URL=https://api.twitterapi.io
TWITTER_USE_MOCK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
